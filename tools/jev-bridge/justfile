# just recipe 集合: jev-bridge 的开发与日常操作
# 用法示例写在每个 recipe 上方的注释里, 最后一行是 just --list 显示的简介.

# 自动加载 .env (放 TYPESAFE_API_KEY 之类的密钥; 该文件已在 .gitignore 中)
set dotenv-load := true

[private]
default:
    @just --list

# 安装依赖并创建 .venv (首次使用)
install:
    uv sync --extra dev

# 跑全部测试 (Python + Lua 纯逻辑)
test:
    uv run pytest
    lua tests/lua/run.lua "{{justfile_directory()}}/../.." /tmp/jev-lua-suite

# 只跑 Python 测试
test-py:
    uv run pytest

# 只跑 Lua 侧测试
test-lua:
    lua tests/lua/run.lua "{{justfile_directory()}}/../.." /tmp/jev-lua-suite

# 前台启动 sidecar (调试用, Ctrl-C 退出)
run *args:
    uv run jev-bridge serve {{args}}

# 前台启动本机 Laya 后端 (隔离: uv tool run, 不装系统服务; 权重在 ~/.cache/huggingface)
laya *args:
    uv run jev-bridge laya {{args}}

# 后台启动 Laya 后端并等 /health 变 200 (首次要下载权重)
laya-bg *args:
    uv run jev-bridge laya --background {{args}}

# 停掉后台的 Laya 后端
laya-stop:
    uv run jev-bridge laya --stop

# 在中文 case 集上量首选率 (对比 checkpoint / 提示词; --fresh 走真实后端)
# 例: just eval --fresh --tag multilingual
eval *args:
    uv run jev-bridge eval {{args}}

# 用云端 TypeSafe Jev 跑同一批 case (key 从 .env 读取; 注意会把上文发送到云端)
# 例: just eval-cloud --cases benchmarks/same_pinyin_cases.json --fresh --tag cloud
eval-cloud *args:
    JEV_BASE_URL=https://api.typesafe.ai JEV_MODEL=jev-latest JEV_ALLOW_CLOUD=1 uv run jev-bridge eval {{args}}

# 只检查 .env 有没有被加载, 不打印任何密钥内容
env-check:
    @test -n "$$TYPESAFE_API_KEY" && echo "TYPESAFE_API_KEY: 已从 .env 加载" || echo "TYPESAFE_API_KEY: 未加载 (检查 tools/jev-bridge/.env)"

# 看 Laya 后端状态
laya-status:
    uv run jev-bridge laya --status

# 处理一次积压队列后退出
once:
    uv run jev-bridge once

# 查询本地 HTTP 健康状态
health:
    uv run jev-bridge health

# 打印最近日志
logs lines="60":
    uv run jev-bridge logs --lines {{lines}}

# 看当前生效配置
config:
    uv run jev-bridge show-config

# 打印按平台推导的全部路径, 并核对两侧 runtime_dir 是否一致
paths:
    uv run jev-bridge paths

# 生成默认配置文件 (~/.config/rime-jev/config.toml)
init-config:
    uv run jev-bridge init-config

# 投递一个请求并等待响应, 用来在不打字的情况下验证整条链路
# 例: just simulate nihao "今天天气"
simulate code context="":
    uv run jev-bridge simulate --code "{{code}}" --context "{{context}}" --timeout-ms 3000

# 延迟基准 (默认走当前后端, 冷缓存)
# 例: just bench 20
bench count="20":
    uv run jev-bridge bench --count {{count}}

# 预览 config 补丁会改成什么 (不改文件)
patch-dry:
    uv run jev-bridge patch-config --dry-run --show-diff

# 把 jev-rerank 块写进 wanxiang.custom.yaml
patch-config:
    uv run jev-bridge patch-config --show-diff

# 从 wanxiang.custom.yaml 里移除 jev-rerank 块
unpatch-config:
    uv run jev-bridge unpatch-config --show-diff

# 校验合并后的 custom 文件是合法 YAML 且 patch 段含关键项
check-config:
    uv run --with pyyaml python -c "import json, yaml; from jev_bridge import paths; target = paths.schema_patch_target(); d = yaml.safe_load(target.read_text(encoding='utf-8')); p = d.get('patch', {}); print(target); print(json.dumps({k: p[k] for k in p if 'jev' in k or 'filters' in k}, ensure_ascii=False, indent=2))"

# 部署 Rime (按平台自动选择命令: Squirrel / WeaselDeployer / fcitx5-remote)
deploy-rime:
    uv run jev-bridge deploy-rime

# 安装 LaunchAgent 让 sidecar 常驻 (仅 macOS)
install-agent:
    uv run jev-bridge install-agent

# 卸载 LaunchAgent (仅 macOS)
uninstall-agent:
    uv run jev-bridge uninstall-agent
