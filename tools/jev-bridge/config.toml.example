# jev-bridge 配置示例
# 复制到 ~/.config/rime-jev/config.toml 即可生效 (或用 `just init-config` 自动生成)
# 每一项都能被同名环境变量覆盖: JEV_BACKEND / JEV_BASE_URL / JEV_MODEL / JEV_ALLOW_CLOUD /
# JEV_RUNTIME_DIR / JEV_HTTP_HOST / JEV_HTTP_PORT / JEV_LOG_LEVEL / JEV_DEBUG / TYPESAFE_API_KEY
# 改完执行 `just config` 看最终生效值, 重启 sidecar 才生效.

# 配置结构版本, 升级由 config_migrations.py 负责, 不要手改
config_version = 2

# ---------------------------------------------------------------- 打分后端

# mock: 零依赖的确定性规则, 只用于验证链路 (排序质量不代表真实模型)
# http: Jev 兼容的 POST /v1/systemone
backend = "mock"

# 本机 Laya (localjev-mlx / laya-mlx) 或云端 TypeSafe Jev
# 端口必须与后端自己监听的端口一致: localjev-mlx 默认就是 8090, 自建服务按实际情况改这一行
base_url = "http://127.0.0.1:8090"
model = "laya-multilingual"
api_key = ""

# 云端后端会把上文送出本机, 必须显式置为 true 才允许访问非本机地址
allow_cloud = false

# ---------------------------------------------------------------- 运行时目录

# 队列/缓存/日志共同的父目录, 默认按平台自动推导, 通常不需要写:
#   macOS   ~/Library/Caches/rime-jev
#   Linux   $XDG_CACHE_HOME/rime-jev 或 ~/.cache/rime-jev
#   Windows %LOCALAPPDATA%\rime-jev
# 它必须与 Rime 侧 jev_rerank/runtime_dir 指向同一个根; 后者由 patch-config 按同一规则写进
# wanxiang.custom.yaml, 想核对就执行 `just paths`.
# runtime_dir = "~/.cache/rime-jev"       # 需要显式指定时解开这一行 (也可用 JEV_RUNTIME_DIR)
# queue_dir / cache_dir / log_dir 不再单独配置, 固定是 <runtime_dir>/{queue,cache,log}

# ---------------------------------------------------------------- 调试端点

# 只用于 curl 调试与手工联调, 打字路径走文件队列
http_host = "127.0.0.1"
http_port = 20006

# ---------------------------------------------------------------- 队列

# 轮询间隔, 越小 sync 模式越快, 代价是空转更频繁
poll_interval_ms = 5
# 预取请求超过这个年龄就直接丢弃 (用户早就换词了, 算出来也没用)
prefetch_max_age_ms = 1500
# 单次后端调用的超时
backend_timeout_ms = 800

# ---------------------------------------------------------------- 缓存

cache_ttl_s = 600
cache_max_entries = 2000

# ---------------------------------------------------------------- 重排规则

max_candidates = 8
# 置信度与首选概率双门限, 任一不达标就保持原顺序
min_confidence = 0.5
min_top_prob = 0.34
badge = "AI"
show_confidence = false

# ---------------------------------------------------------------- 日志

log_level = "INFO"
debug = false
